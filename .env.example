# Transport for London Unified API – https://api-portal.tfl.gov.uk/
# Server-side only. Never prefix with VITE_ (that would expose them in the browser bundle).
TFL_APP_ID=
TFL_APP_KEY=

# Optional basemap style for the Tube map (MapLibre style JSON URL)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Londynek.net content API (see docs/API_CONTRACT.md). Public base URL – no secrets here.
# Empty = the site uses the bundled demo data.
VITE_LONDYNEK_API_URL=

# Form submissions (server-side only). With a webhook URL, submissions are POSTed there as JSON;
# otherwise they are appended to FORMS_STORE_FILE (JSON Lines).
FORMS_WEBHOOK_URL=
FORMS_STORE_FILE=data/form-submissions.jsonl
